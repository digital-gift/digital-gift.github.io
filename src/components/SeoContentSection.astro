      { title: '100% Sin Servidores', desc: 'Todo se comprime en el enlace URL. Cero bases de datos y privacidad total.', icon: '🔒' },
      { title: 'Sin Instalaciones', desc: 'El destinatario lo abre al instante en cualquier navegador.', icon: '⚡' },
      { title: 'Apertura 3D Interactiva', desc: 'Animación de apertura, confeti y música generada en el navegador.', icon: '🎁' }
    ],
    faqTitle: 'Preguntas Frecuentes',
