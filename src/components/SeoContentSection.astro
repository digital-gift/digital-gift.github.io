  fr: {
    howItWorksTitle: 'Comment ça marche en 4 étapes simples',
    howItWorksSubtitle: 'Créez une surprise inoubliable en moins de 60 secondes.',
    steps: [
      { title: '1. Destinataire & Occasion', desc: 'Renseignez le prénom et l’événement à célébrer.', icon: '🎯' },
      { title: '2. Style & Effets Sonores', desc: 'Personnalisez les couleurs, confettis et mélodies.', icon: '🎨' },
      { title: '3. Message & Photo', desc: 'Rédigez vos vœux chaleureux et ajoutez une photo souvenir.', icon: '💌' },
      { title: '4. Lien Magique Immédiat', desc: 'Partagez directement par WhatsApp ou copiez le lien.', icon: '🚀' }
    ],
