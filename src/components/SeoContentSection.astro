const c = contentData[locale] || contentData.en;
---

<section class="w-full max-w-5xl mx-auto px-4 py-16 space-y-20 border-t border-gray-200/60 dark:border-brand-darkBorder mt-12">
  <!-- How It Works Section -->
  <div id="how-it-works" class="space-y-8 text-center">
    <div class="space-y-3">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight">
        {c.howItWorksTitle}
      </h2>
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        {c.howItWorksSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-left">
      {c.steps.map((step) => (
        <article class="p-6 rounded-2xl bg-white dark:bg-brand-darkSurface border border-gray-200/80 dark:border-brand-darkBorder shadow-md hover:shadow-lg transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-3xl">{step.icon}</span>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white">
              {step.title}
            </h3>
            <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
              {step.desc}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Why Choose DigitalGift -->
  <div id="features" class="space-y-8 text-center">
    <div class="space-y-3">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight">
        {c.whyTitle}
      </h2>
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        {c.whySubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
      {c.features.map((feature) => (
        <article class="p-6 rounded-2xl bg-white dark:bg-brand-darkSurface border border-gray-200/80 dark:border-brand-darkBorder shadow-md hover:shadow-lg transition-all space-y-3">
          <span class="text-3xl">{feature.icon}</span>
          <h3 class="text-lg font-bold text-brand-deep dark:text-brand-mint">
            {feature.title}
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
            {feature.desc}
          </p>
        </article>
      ))}
    </div>
  </div>

  <!-- Frequently Asked Questions (FAQ) with Schema Matching -->
  <div id="faq" class="space-y-8 max-w-3xl mx-auto">
    <div class="text-center space-y-3">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight">
        {c.faqTitle}
      </h2>
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300">
        {c.faqSubtitle}
      </p>
    </div>

    <div class="space-y-4">
      {c.faqs.map((faq) => (
        <details class="group p-5 rounded-2xl bg-white dark:bg-brand-darkSurface border border-gray-200/80 dark:border-brand-darkBorder shadow-sm transition-all">
          <summary class="font-bold text-base sm:text-lg text-gray-900 dark:text-white cursor-pointer list-none flex items-center justify-between">
            <span>{faq.q}</span>
            <span class="transition-transform group-open:rotate-180 text-brand-deep dark:text-brand-mint">
              ▼
            </span>
          </summary>
          <p class="mt-4 text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed border-t border-gray-100 dark:border-brand-darkBorder pt-3">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
