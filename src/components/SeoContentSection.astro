    whySubtitle: 'Des cadeaux virtuels interactifs sans aucun serveur ni collecte de données.',
    features: [
      { title: 'Zéro Serveur & Confidentialité', desc: 'Les données sont compressées dans le lien URL avec LZ-String.', icon: '🔒' },
      { title: 'Aucune Application Requise', desc: 'S’ouvre directement sur smartphone et ordinateur.', icon: '⚡' },
      { title: 'Déballage 3D Animé', desc: 'Explosion de confettis, envol du couvercle et mélodies Web Audio.', icon: '🎁' }
    ],
    faqTitle: 'Foire Aux Questions',
    faqSubtitle: 'Tout savoir sur la création de cadeaux virtuels.',
    faqs: [
      { q: 'Comment créer un cadeau virtuel gratuit ?', a: 'Remplissez le formulaire, personnalisez l’ambiance et partagez votre lien magique.' },
      { q: 'Mes messages ou photos sont-ils stockés ?', a: 'Non. Tout s’exécute 100% dans votre navigateur, aucun serveur n’est utilisé.' },
      { q: 'Comment le destinataire ouvre-t-il le cadeau ?', a: 'Il clique sur le lien et touche la boîte 3D pour lancer l’animation.' },
