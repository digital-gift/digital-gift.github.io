---
import type { SupportedLocale } from '../types/gift';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;

interface SeoContentText {
  howItWorksTitle: string;
  howItWorksSubtitle: string;
  steps: { title: string; desc: string; icon: string }[];
  whyTitle: string;
  whySubtitle: string;
  features: { title: string; desc: string; icon: string }[];
  faqTitle: string;
  faqSubtitle: string;
  faqs: { q: string; a: string }[];
}

const contentData: Record<SupportedLocale, SeoContentText> = {
  en: {
    howItWorksTitle: 'How It Works in 4 Simple Steps',
    howItWorksSubtitle: 'Crafting a memorable digital unboxing experience takes less than 60 seconds.',
    steps: [
      {
        title: '1. Recipient & Occasion',
        desc: 'Specify the recipient name and choose between Birthday, Anniversary, Appreciation, or Celebration.',
        icon: '🎯'
      },
      {
        title: '2. Box & Audio Effects',
        desc: 'Choose luxury colors, ribbons, confetti explosions (balloons, stars, fireworks), and Web Audio synth chimes.',
        icon: '🎨'
      },
      {
        title: '3. Personal Note & Photo',
        desc: 'Add your heartfelt wishes and an optional photo, automatically downscaled to lightweight WebP.',
        icon: '💌'
      },
      {
        title: '4. Instant Magic Link',
        desc: 'Copy your generated URL hash link or share instantly via WhatsApp. Zero databases, 100% private.',
        icon: '🚀'
      }
    ],
    whyTitle: 'Why Choose DigitalGift? 100% Privacy-First Architecture',
    whySubtitle: 'The modern way to share heartfelt surprises without compromising privacy or tracking.',
    features: [
      {
        title: 'Zero-Server Privacy',
        desc: 'All gift card details are compressed directly into the shareable URL hash using LZ-String. No database, zero tracking, and no cookies.',
        icon: '🔒'
      },
      {
        title: 'Zero App Installs Required',
        desc: 'Your recipient opens the surprise directly in any modern mobile or desktop browser without downloading apps or creating accounts.',
        icon: '⚡'
      },
      {
        title: 'Interactive 3D Unboxing Theater',
        desc: 'Features smooth SVG 3D wobble physics, lid-flying animations, canvas-confetti bursts, and harmonious Web Audio API melodies.',
        icon: '🎁'
      }
    ],
    faqTitle: 'Frequently Asked Questions',
    faqSubtitle: 'Everything you need to know about creating and sending free virtual gifts.',
    faqs: [
      {
        q: 'How do I create and send a virtual gift box for free?',
        a: 'Enter your recipient\'s name, select the celebration occasion, customize the 3D gift box colors and music, write your personal message, and generate a free magic link. You can copy the link or share it directly via WhatsApp.'
      },
      {
        q: 'Does DigitalGift store my personal messages or photos on a server?',
        a: 'No. DigitalGift is 100% client-side and zero-server. Your entire gift state, including message and compressed photo, is encoded directly into the shareable URL hash using LZ-string compression. No data is ever sent to or stored on any server.'
      },
      {
        q: 'How does the recipient open the digital surprise gift?',
        a: 'When your recipient opens the magic link, they see an interactive animated 3D gift box. Tapping the box triggers a dynamic lid-flying animation, multi-color confetti, celebratory audio tunes, and unveils your personal greeting card.'
      },
      {
        q: 'Which celebration occasions are supported?',
        a: 'DigitalGift supports Birthdays, Anniversaries, Appreciation & Thank You messages, and General Congratulations celebrations.'
      }
    ]
  },
  es: {
    howItWorksTitle: 'Cómo Funciona en 4 Sencillos Pasos',
    howItWorksSubtitle: 'Crear una experiencia mágica de apertura toma menos de 60 segundos.',
    steps: [
      { title: '1. Destinatario y Ocasión', desc: 'Indica a quién va dirigido y la ocasión especial.', icon: '🎯' },
      { title: '2. Diseño y Sonido', desc: 'Elige colores, lazos, estilo de confeti y melodías festivas.', icon: '🎨' },
      { title: '3. Mensaje y Foto', desc: 'Escribe tus mejores deseos y adjunta una foto opcional.', icon: '💌' },
      { title: '4. Enlace Mágico', desc: 'Copia el enlace o compártelo al instante por WhatsApp.', icon: '🚀' }
    ],
