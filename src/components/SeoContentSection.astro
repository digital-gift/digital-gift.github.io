    ]
  },
  pt: {
    howItWorksTitle: 'Como Funciona em 4 Passos Simples',
    howItWorksSubtitle: 'Crie uma experiência mágica de presente em menos de 1 minuto.',
    steps: [
      { title: '1. Destinatário e Ocasião', desc: 'Escolha para quem é e o tipo de comemoração.', icon: '🎯' },
      { title: '2. Estilo e Música', desc: 'Escolha cores da caixa, confetes e sons festivos.', icon: '🎨' },
      { title: '3. Mensagem e Foto', desc: 'Escreva suas palavras especiais e anexe uma foto.', icon: '💌' },
      { title: '4. Link Mágico Imediato', desc: 'Copie ou envie direto pelo WhatsApp.', icon: '🚀' }
    ],
    whyTitle: 'Por Que Escolher o DigitalGift? Privacidade Total',
    whySubtitle: 'O jeito moderno e seguro de enviar surpresas digitais.',
    features: [
      { title: '100% Sem Servidor', desc: 'Tudo é compactado diretamente no link com LZ-String.', icon: '🔒' },
      { title: 'Sem Instalar Aplicativos', desc: 'Abre instantaneamente em qualquer navegador.', icon: '⚡' },
      { title: 'Abertura 3D Interativa', desc: 'Tampa animada, explosão de confetes e música festiva.', icon: '🎁' }
    ],
    faqTitle: 'Perguntas Frequentes',
    faqSubtitle: 'Tire suas dúvidas sobre o gerador de presentes.',
    faqs: [
      { q: 'Como criar um presente virtual grátis?', a: 'Preencha o formulário, escolha os efeitos e copie o seu link mágico.' },
      { q: 'Minha foto e mensagem são salvas em algum banco de dados?', a: 'Não. Tudo fica compactado no próprio link do navegador.' },
      { q: 'Como a pessoa abre a caixa?', a: 'Ela clica no link e toca na caixa 3D para revelar o presente.' },
      { q: 'Quais ocasiões posso escolher?', a: 'Aniversário, bodas, gratidão e parabéns em geral.' }
    ]
  },
  ja: {
    howItWorksTitle: '4つの簡単ステップで作成',
    howItWorksSubtitle: '感動の3Dサプライズ体験をわずか1分で作成できます。',
    steps: [
      { title: '1. お相手とイベント選択', desc: 'お相手の名前とお祝いの種類（誕生日・記念日等）を指定。', icon: '🎯' },
      { title: '2. ボックス・音・演出', desc: '箱の色、リボン、紙吹雪の種類、Web Audioメロディを選択。', icon: '🎨' },
      { title: '3. メッセージと写真', desc: 'お祝いメッセージを入力し、写真を軽量添付。', icon: '💌' },
